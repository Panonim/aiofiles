#!/bin/sh
# s6-overlay oneshot: everything that has to happen as root before the
# `aiofiles` and `nginx` longruns are started as the unprivileged app user.
#
# Invoked via `with-contenv`, so the container's environment is visible here.
# Any non-zero exit aborts the boot, because the image sets
# S6_BEHAVIOUR_IF_STAGE2_FAILS=2.
set -eu

log() { echo "init-aiofiles: $*" >&2; }

PUID="${PUID:-1000}"
PGID="${PGID:-1000}"
DATA_DIR="${DATA_DIR:-/data}"
MAX_UPLOAD_MIB="${MAX_UPLOAD_MIB:-4096}"

# Where the Go server binds. 
LISTEN_ADDR="${LISTEN_ADDR:-127.0.0.1:1144}"

# The nginx config is rendered from these, and the Go process reads the same
# two variables, so a change here moves both ends at once. An XACCEL_PREFIX
# that is set but empty means "let Go stream the file"; nginx keeps the default
# location in that case, unused but valid.
DOWNLOAD_DIR="${DOWNLOAD_DIR:-$DATA_DIR/downloads}"
XACCEL_PREFIX="${XACCEL_PREFIX:-/_protected}"

CONTENV=/run/s6/container_environment

# ---------------------------------------------------------------------------
# 1. App user and group
#
# busybox has no usermod/groupmod, so instead of mutating a baked-in account
# we resolve whatever already owns PUID/PGID and only create an account when
# the id is genuinely unused. This keeps `s6-setuidgid` working for any PUID,
# including 0. /etc/{passwd,group} are parsed directly rather than via getent
# so this does not depend on which busybox applets Alpine happened to enable.
# ---------------------------------------------------------------------------
name_for_id()   { awk -F: -v id="$2" '$3 == id { print $1; exit }' "$1"; }
name_is_taken() { awk -F: -v n="$2" '$1 == n { f = 1 } END { exit !f }' "$1"; }

APP_GROUP="$(name_for_id /etc/group "$PGID")"
if [ -z "$APP_GROUP" ]; then
    APP_GROUP=aiofiles
    if name_is_taken /etc/group "$APP_GROUP"; then
        APP_GROUP="app${PGID}"
    fi
    addgroup -g "$PGID" "$APP_GROUP"
fi

APP_USER="$(name_for_id /etc/passwd "$PUID")"
if [ -z "$APP_USER" ]; then
    APP_USER=aiofiles
    if name_is_taken /etc/passwd "$APP_USER"; then
        APP_USER="app${PUID}"
    fi
    adduser -D -H -u "$PUID" -G "$APP_GROUP" -s /sbin/nologin "$APP_USER"
fi

log "services will run as ${APP_USER}:${APP_GROUP} (${PUID}:${PGID})"

# Publish the resolved name so the longrun `run` scripts can s6-setuidgid it.
printf '%s' "$APP_USER" > "$CONTENV/APP_USER"

# ---------------------------------------------------------------------------
# 2. Data directories
#
# The chown is deliberately NOT recursive: on a large downloads volume that
# would walk every file on every boot. Set FIX_OWNERSHIP=1 once after changing
# PUID/PGID to repair pre-existing files.
# ---------------------------------------------------------------------------
mkdir -p "$DATA_DIR/downloads" "$DATA_DIR/tmp" "$DATA_DIR/uploads" "$DATA_DIR/db"
chown "$PUID:$PGID" \
    "$DATA_DIR" \
    "$DATA_DIR/downloads" "$DATA_DIR/tmp" "$DATA_DIR/uploads" "$DATA_DIR/db"
chmod 0750 \
    "$DATA_DIR/downloads" "$DATA_DIR/tmp" "$DATA_DIR/uploads" "$DATA_DIR/db"

if [ "${FIX_OWNERSHIP:-0}" = "1" ]; then
    log "FIX_OWNERSHIP=1: recursively chowning ${DATA_DIR} (this can take a while)"
    chown -R "$PUID:$PGID" "$DATA_DIR"
fi

# ---------------------------------------------------------------------------
# 3. nginx configuration
#
# Render the template first, then let `nginx -t` create and validate the temp
# path directories, then chown them - if we chowned first, the config test
# (running as root) would recreate them root-owned.
#
# The three values are validated before substitution: they are pasted into a
# sed replacement and then into a config file, so anything outside a plain path
# alphabet is refused here rather than turned into a confusing nginx error.
# ---------------------------------------------------------------------------
case "$MAX_UPLOAD_MIB" in
    ''|*[!0-9]*)
        log "FATAL: MAX_UPLOAD_MIB must be a whole number of MiB (got '${MAX_UPLOAD_MIB}')"
        exit 1
        ;;
esac

# 0 is how nginx spells "no limit", and it is what the Go handler does at 0 as
# well. Any other value gets 64 MiB of headroom so the app's JSON 413 wins over
# nginx's HTML one.
if [ "$MAX_UPLOAD_MIB" -eq 0 ]; then
    NGINX_CLIENT_MAX_BODY=0
else
    NGINX_CLIENT_MAX_BODY="$(( MAX_UPLOAD_MIB + 64 ))m"
fi

check_path() {
    case "$2" in
        /*) ;;
        *)  log "FATAL: $1 must be an absolute path (got '$2')"; exit 1 ;;
    esac
    case "$2" in
        *[!A-Za-z0-9._/-]*)
            log "FATAL: $1 may only contain letters, digits and . _ - / (got '$2')"
            exit 1
            ;;
    esac
}
check_path DOWNLOAD_DIR "$DOWNLOAD_DIR"
check_path XACCEL_PREFIX "$XACCEL_PREFIX"

# host:port only - this is pasted into a sed replacement and then into
# `proxy_pass http://...;`, so anything outside that alphabet is refused here
# rather than turned into a confusing nginx error (or worse, a config
# injection via a stray `;`).
case "$LISTEN_ADDR" in
    *[!A-Za-z0-9.:-]*)
        log "FATAL: LISTEN_ADDR must be a bare host:port (got '${LISTEN_ADDR}')"
        exit 1
        ;;
esac

# The template writes the trailing slash itself, on both the location and the
# alias; nginx needs them to match.
NGINX_XACCEL_PREFIX="${XACCEL_PREFIX%/}"
NGINX_DOWNLOAD_DIR="${DOWNLOAD_DIR%/}"

sed -e "s|__CLIENT_MAX_BODY__|${NGINX_CLIENT_MAX_BODY}|g" \
    -e "s|__XACCEL_PREFIX__|${NGINX_XACCEL_PREFIX}|g" \
    -e "s|__DOWNLOAD_DIR__|${NGINX_DOWNLOAD_DIR}|g" \
    -e "s|__INTERNAL_ADDR__|${LISTEN_ADDR}|g" \
    /etc/nginx/nginx.conf.template > /etc/nginx/nginx.conf

# ---------------------------------------------------------------------------
# 3b. Host guard
#
# ALLOWED_HOSTS and PROXY_ONLY are enforced by the Go process for the API. The
# frontend is served by nginx and never reaches Go, so the same rules are
# rendered into a $host map here. Both ends read the same two variables, and
# the matching below is written to mirror config.HostAllowed:
#
#   ALLOWED_HOSTS empty          -> every name is accepted
#   ALLOWED_HOSTS=a.example.com  -> that name only
#   ALLOWED_HOSTS=*.example.com  -> subdomains at any depth, not the bare domain
#   ALLOWED_HOSTS=*             -> every name, explicitly
#   PROXY_ONLY=1                 -> no IP literal and no empty Host
#
# nginx lowercases $host and strips the port before the map is consulted, which
# is the same normalisation the Go side applies.
# ---------------------------------------------------------------------------
GUARD=/etc/nginx/host-guard.conf
ALLOWED_HOSTS="${ALLOWED_HOSTS:-}"

case "$(printf '%s' "${PROXY_ONLY:-0}" | tr 'A-Z' 'a-z')" in
    1|true|yes|on) PROXY_ONLY_FLAG=1 ;;
    *)             PROXY_ONLY_FLAG=0 ;;
esac

# Splitting on commas means the entries go through word splitting unquoted, and
# a "*.example.com" - or a lone "*" - would otherwise be expanded against the
# working directory. Globbing stays off for the rest of the guard.
set -f

# A lone "*" anywhere in the list is the documented "any name" escape hatch,
# which also switches the per-entry matching off.
ANY_HOST=0
OLDIFS="$IFS"
IFS=','
for raw in $ALLOWED_HOSTS; do
    if [ "$(printf '%s' "$raw" | tr -d ' \t')" = '*' ]; then
        ANY_HOST=1
    fi
done
IFS="$OLDIFS"

emit_host_entries() {
    OLDIFS="$IFS"
    IFS=','
    for raw in $ALLOWED_HOSTS; do
        h="$(printf '%s' "$raw" | tr -d ' \t' | tr 'A-Z' 'a-z')"
        [ -n "$h" ] || continue
        # Anything outside a host alphabet would be pasted straight into an
        # nginx map, so it is refused here rather than turned into a confusing
        # parse error at `nginx -t`. (Colons and brackets are for an IPv6
        # literal, which is the one entry that carries them.)
        if [ -n "$(printf '%s' "$h" | tr -d 'a-z0-9.*_:[]-')" ]; then
            log "FATAL: ALLOWED_HOSTS entry '${raw}' is not a hostname, an IP literal or *.suffix"
            exit 1
        fi
        # A colon is a port unless the whole entry is a bracketed IPv6 literal.
        # nginx strips the port from $host, so an entry carrying one would match
        # nothing; the Go side refuses to start on it for the same reason.
        case "$h" in
            '['*']') ;;
            *:*)
                log "FATAL: ALLOWED_HOSTS entry '${raw}' must not carry a port"
                exit 1
                ;;
        esac
        case "$h" in
            '*.'*)
                body="${h#\*.}"
                case "$body" in
                    ''|*'*'*)
                        log "FATAL: ALLOWED_HOSTS entry '${raw}' may only use * as a leading label"
                        exit 1
                        ;;
                esac
                # ".example.com" with the dots escaped, so "aioXexample.com"
                # does not match. ".+" is the subdomain, hence at least one
                # character: the bare domain is a different name.
                re="$(printf '%s' ".$body" | sed 's/\./\\./g')"
                printf '    "~^.+%s$" 0;\n' "$re"
                ;;
            *'*'*)
                log "FATAL: ALLOWED_HOSTS entry '${raw}' may only use * as a leading label"
                exit 1
                ;;
            *)
                printf '    "%s" 0;\n' "$h"
                ;;
        esac
    done
    IFS="$OLDIFS"
}

# The two rules are kept in separate maps and combined in a third, because
# that is exactly how the Go side reads them: a request is refused when
# PROXY_ONLY rejects the address form, OR when the name is not in the list.
{
    echo "# Generated by init-aiofiles from ALLOWED_HOSTS / PROXY_ONLY."
    echo "# Edits are overwritten on the next start."
    echo

    echo "# PROXY_ONLY: an IP literal, or no Host at all, is not a name a proxy is reached by."
    echo "map \$host \$aiofiles_host_is_address {"
    echo "    default 0;"
    if [ "$PROXY_ONLY_FLAG" = 1 ]; then
        echo '    "" 1;'
        echo '    "~^[0-9]{1,3}(\.[0-9]{1,3}){3}$" 1;'
        echo '    "~^\[[0-9a-f:.]+\]$" 1;'
    fi
    echo "}"
    echo

    echo "# ALLOWED_HOSTS: 0 means listed. An empty list lists everything."
    echo "map \$host \$aiofiles_host_unlisted {"
    if [ -n "$ALLOWED_HOSTS" ] && [ "$ANY_HOST" = 0 ]; then
        echo "    default 1;"
        emit_host_entries
    else
        echo "    default 0;"
    fi
    echo "}"
    echo

    echo "map \"\$aiofiles_host_is_address\$aiofiles_host_unlisted\" \$aiofiles_host_blocked {"
    echo "    default 1;"
    echo '    "00" 0;'
    echo "}"
} > "$GUARD"

if [ -n "$ALLOWED_HOSTS" ] || [ "$PROXY_ONLY_FLAG" = 1 ]; then
    log "host guard active (ALLOWED_HOSTS='${ALLOWED_HOSTS}', PROXY_ONLY=${PROXY_ONLY_FLAG})"
fi

# ---------------------------------------------------------------------------
# 3c. Forwarding headers
#
# X-Real-IP, X-Forwarded-Proto and X-Forwarded-Host are single-valued: writing
# them unconditionally erases whatever an outer proxy put there. This nginx is
# always reached over plain HTTP, so doing that turns "the browser is on HTTPS"
# into "the browser is on HTTP" - which is what decides the Secure attribute on
# the session cookie and which origin the API compares a POST's Origin against.
#
# So they are passed through instead, but only when the peer is a proxy the
# operator vouched for. TRUSTED_PROXIES is the same list the Go process reads,
# and loopback is trusted on top of it in both places.
#
#   TRUSTED_PROXIES empty       -> loopback only; each header is written fresh
#   TRUSTED_PROXIES=172.18.0/16 -> a proxy on that network keeps its own values
#
# X-Forwarded-For is not in here: nginx appends to that one
# ($proxy_add_x_forwarded_for), so a chain in front of us survives untouched
# and the Go side walks it from the right.
# ---------------------------------------------------------------------------
FORWARDED=/etc/nginx/forwarded.conf
TRUSTED_PROXIES="${TRUSTED_PROXIES:-}"

emit_trusted_entries() {
    OLDIFS="$IFS"
    IFS=','
    for raw in $TRUSTED_PROXIES; do
        p="$(printf '%s' "$raw" | tr -d ' \t')"
        [ -n "$p" ] || continue
        # Pasted straight into an nginx geo block, so anything outside an
        # address/CIDR alphabet is refused here rather than turned into a
        # confusing parse error at `nginx -t`. The Go side rejects the same
        # entries at startup, with a message naming the offending value.
        if [ -n "$(printf '%s' "$p" | tr -d '0-9a-fA-F.:/')" ]; then
            log "FATAL: TRUSTED_PROXIES entry '${raw}' is not an IP address or a CIDR block"
            exit 1
        fi
        printf '    %s 1;\n' "$p"
    done
    IFS="$OLDIFS"
}

{
    echo "# Generated by init-aiofiles from TRUSTED_PROXIES."
    echo "# Edits are overwritten on the next start."
    echo

    echo "# 1 when the peer is a proxy whose forwarding headers we believe."
    echo "geo \$aiofiles_peer_trusted {"
    echo "    default     0;"
    echo "    127.0.0.0/8 1;"
    echo "    ::1/128     1;"
    emit_trusted_entries
    echo "}"
    echo

    # Two maps per header: the first blanks an untrusted peer's value, the
    # second substitutes this hop's own view for anything still blank. nginx
    # has no conditional in a `proxy_set_header`, so this pair is how one is
    # spelled.
    for pair in \
        'proto:http_x_forwarded_proto:scheme' \
        'host:http_x_forwarded_host:host' \
        'real_ip:http_x_real_ip:remote_addr'
    do
        name="${pair%%:*}"
        rest="${pair#*:}"
        from="${rest%%:*}"
        fallback="${rest#*:}"

        echo "map \$aiofiles_peer_trusted \$aiofiles_peer_${name} {"
        echo "    default \"\";"
        echo "    1       \$${from};"
        echo "}"
        echo "map \$aiofiles_peer_${name} \$aiofiles_fwd_${name} {"
        echo "    default \$aiofiles_peer_${name};"
        echo "    \"\"      \$${fallback};"
        echo "}"
        echo
    done
} > "$FORWARDED"

set +f

if [ -n "$TRUSTED_PROXIES" ]; then
    log "trusting forwarding headers from ${TRUSTED_PROXIES} (and loopback)"
fi

mkdir -p /run/nginx /var/log/nginx /var/lib/nginx

if ! /usr/sbin/nginx -t -c /etc/nginx/nginx.conf; then
    log "FATAL: generated /etc/nginx/nginx.conf does not parse"
    exit 1
fi

chown -R "$PUID:$PGID" /run/nginx /var/log/nginx /var/lib/nginx
log "nginx client_max_body_size = ${NGINX_CLIENT_MAX_BODY} (MAX_UPLOAD_MIB=${MAX_UPLOAD_MIB})"
log "nginx X-Accel location = ${NGINX_XACCEL_PREFIX}/ -> ${NGINX_DOWNLOAD_DIR}/"
log "nginx proxies /api to ${LISTEN_ADDR}"

# ---------------------------------------------------------------------------
# 4. Authentication
#
# AUTH_PASSWORD_HASH is the supported production input. AUTH_PASSWORD is a
# convenience for compose users: hash it here and export the result, so the
# plaintext never reaches the app's own configuration. It is still visible via
# `docker inspect`, which the README calls out.
# ---------------------------------------------------------------------------
if [ -z "${AUTH_USERNAME:-}" ]; then
    log "WARNING: AUTH_USERNAME is not set - the UI and API are UNAUTHENTICATED."
    log "WARNING: do not publish this container beyond localhost or a trusted LAN."
elif [ -z "${AUTH_PASSWORD_HASH:-}" ]; then
    if [ -z "${AUTH_PASSWORD:-}" ]; then
        log "FATAL: AUTH_USERNAME is set but neither AUTH_PASSWORD_HASH nor AUTH_PASSWORD is."
        exit 1
    fi
    if ! hash="$(/usr/local/bin/aiofiles -hash-password "$AUTH_PASSWORD")"; then
        log "FATAL: could not derive an argon2id hash from AUTH_PASSWORD"
        exit 1
    fi
    # No trailing newline: s6-envdir would otherwise hand the app a hash with
    # a stray byte on the end.
    printf '%s' "$hash" > "$CONTENV/AUTH_PASSWORD_HASH"
    log "derived AUTH_PASSWORD_HASH from AUTH_PASSWORD (prefer setting the hash directly)"
fi

# Keep the plaintext out of the service environment even when it was used.
rm -f "$CONTENV/AUTH_PASSWORD"

log "init complete"

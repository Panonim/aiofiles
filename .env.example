# Authentication

# Login username. Leave EMPTY to disable authentication completely - only do
# that if the container is bound to localhost and you are the only user.
AUTH_USERNAME=

# Plaintext password. Convenient, but visible in `docker inspect`, in your
# shell history and in `.env`; the container hashes it at every start.
# Prefer AUTH_PASSWORD_HASH below.
AUTH_PASSWORD=

# argon2id hash, generated with:
#   docker compose run --rm --entrypoint aiofiles aiofiles -hash-password 'your password'
#
# MUST be single-quoted: the value contains '$' characters and Compose expands
# unquoted variables inside .env.
#   AUTH_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=2$c2FsdA$aGFzaA'
#
# If this is set it wins and AUTH_PASSWORD is ignored.
AUTH_PASSWORD_HASH=

# How long a login session stays valid, in hours. 720 = 30 days.
SESSION_TTL_HOURS=720

# Reverse proxy

# Comma-separated IPs or CIDR blocks whose X-Forwarded-* headers are believed.
TRUSTED_PROXIES=

# Names this instance answers to, comma-separated. Empty means any name, which
# is the default so a fresh LAN install works over http://<ip>:1144.
#   ALLOWED_HOSTS=aio.example.com,*.media.example.com
ALLOWED_HOSTS=

# Set to 1 to refuse anything that did not come through a reverse proxy: a
# request whose Host is a bare address is rejected, so
#   http://127.0.0.1  -> 403
#   https://aio.example.com     -> works
PROXY_ONLY=0

# Internal address the Go server binds to.
LISTEN_ADDR=127.0.0.1:1144

# Jobs and storage

# How many yt-dlp/ffmpeg/magick processes may run at once. Each one will
# happily use every core you give it, so 2 is a sane default on a small box.
MAX_CONCURRENT_JOBS=2

# How many jobs may sit waiting in the queue before new submissions are rejected.
QUEUE_DEPTH=256

# Default retention for a new job, in days. 0 means keep forever. Individual
# jobs can override this in the UI.
DEFAULT_RETENTION_DAYS=7

# Largest single upload accepted, in MiB. nginx's client_max_body_size is
# derived from this at startup (this value + 64 MiB of headroom), so raising
# it here is enough - there is no second place to change.
#
# 0 means unlimited, in the app and in nginx alike. Only whole numbers are
# accepted: "4G" or a negative value stops the container at boot.
MAX_UPLOAD_MIB=4096

# Container
PUID=1000
PGID=1000
TZ=UTC

# Log verbosity: debug | info | warn | error.
LOG_LEVEL=warn

# Set to 1 to disable the once-per-day GitHub release update check in Settings.
DISABLE_UPDATE_CHECKS=0

# Set to 1 for ONE start after changing PUID/PGID: it recursively chowns
# /data, which is slow on a large library. Set back to 0 afterwards.
FIX_OWNERSHIP=0